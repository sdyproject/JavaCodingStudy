package _250320;

public class 수_조작하기 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int n = 0;
		String c ="wsdawsdassw";
		int answer =0;
	
			for(int i=0; i<c.length(); i++) {
				answer = (c.charAt(i)=='w') ? n+=1:
						 (c.charAt(i)=='s') ? n-=1 : 
					     (c.charAt(i)=='d') ? n+10 : n-10;
				System.out.println(answer);
			}
			System.out.println(answer);
	}

}
