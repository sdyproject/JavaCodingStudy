package _250317;

public class 원소들의_곱과_합 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int num_list[] = {5, 7, 8, 3};
//		int num_list_len = num_list.length;
		int sum = 0;
		int multiply = 1;
		for(int i : num_list) {
			

            multiply *= num_list[i];
            sum += num_list[i];
            
            
		}
		
		
		System.out.println(sum*sum);
		System.out.println(multiply);
		/* 기존 내 풀이
		 * int answer = (multiply<sum*sum) ? 1 : 0;
		 */		
		int answer = Math.pow(sum,2) > multiply ? 1 : 0;
		System.out.println(answer);
	}

}
