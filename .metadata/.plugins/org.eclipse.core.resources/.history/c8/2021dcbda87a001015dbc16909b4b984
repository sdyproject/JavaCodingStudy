package _250816;

import java.util.Arrays;

public class 최대공약수와_최소공배수 {

	public static void main(String[] args) {
//		int n= 3; int m =12;
//		int n= 2; int m =5;
		int n= 5; int m =2;
		 int[] answer = new int[2];
		
		 
		if(n<m) {
			int temp  = m;
			int temp_2 = n;
			while(temp_2!=0) {
				
				int num = temp % temp_2;
				temp = temp_2;
				temp_2 = num;
				answer[0]= temp;
				answer[1] = (n*m) / temp;
			}
		}else {
			int temp  = m;
			int temp_2 = n;
			while(temp_2!=0) {
				
				int num = temp_2 % temp;
				temp_2 = temp;
				temp = num;
				answer[0]= temp_2;
				answer[1] = (n*m) / temp_2;
			}
		}
		
		System.out.println(Arrays.toString(answer));
	}

}
