package _250325;

import java.util.Arrays;

public class 문자열_여러번_뒤집기 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		String my_string = "rermgorpsam";
		int[][] queries = {{2, 3}, {0, 7}, {5, 9}, {6, 10}};
	//	 String answer = "";
		String[] answer = new String[my_string.length()];
		String c ="";
		System.out.println(queries[0][0]);
		System.out.println(queries[0][1]);

		for(int i =0; i<queries.length; i++) {
			for(int j =0; j<my_string.length(); i++) {
				         c   += Character.toString(my_string.charAt(queries[i][0]));
				        answer[queries[i][0]] = c;
				        answer[queries[i][1]] = Character.toString(my_string.charAt(queries[i][1])) ;
			}
		}
		System.out.println(answer);
	}

}
