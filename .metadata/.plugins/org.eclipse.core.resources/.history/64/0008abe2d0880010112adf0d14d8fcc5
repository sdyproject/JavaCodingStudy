package 약수_배수와_소수_1;

import java.util.ArrayList;
import java.util.Scanner;

public class 약수들의_합 {

	public static void main(String[] args) {

		Scanner sc = new Scanner(System.in);

		while (true) {

			int n = sc.nextInt();
			if (n == -1) {
				break;
			}
			int sum = 0;
			ArrayList<Integer> arr = new ArrayList<>();

			for (int i = 1; i <= n; i++) {
				if (n % i == 0) {
					sum += i;
					arr.add(i);
				}
				if(sum == n) {
					break;
				}

			}
			System.out.println(arr);
			System.out.println(sum);
		}

	}

}
