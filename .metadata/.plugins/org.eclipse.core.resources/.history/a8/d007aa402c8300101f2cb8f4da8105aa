package _2차원_배열;

import java.util.Scanner;

public class 최댓값 {

	public static void main(String[] args) {

		
	 Scanner sc =  new Scanner(System.in);
	 
	 int[][] arr =  new int[9][9];
	 int max = 0;

		for (int i = 0; i < arr.length; i++) {
			for (int j = 0; j < arr.length; j++) {
				int n = sc.nextInt();
				arr[i][j] = n;
			}
		}
		
		
		for (int i = 0; i < arr.length; i++) {
		    for (int j = 0; j < arr.length; j++) {
		        if(max<arr[i][j]) {
		        	max = arr[i][j];
		        	
		        }
		    }
		}
	 System.out.println(max);
	}

}
