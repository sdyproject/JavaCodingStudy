package _250417;

public class 글자_지우기 {

	public static void main(String[] args) {
		String my_string ="apporoograpemmemprs";
		int[] indices = {1, 16, 6, 15, 0, 10, 11, 3};
		 String answer = "";
		 
		 char[] ch = my_string.toCharArray();
		 
		 int index =0;
		 for(int i =0; i<ch.length; i++) {
			 if(i!=indices[index]) {
				 answer+=ch[i];
				 index++;
			 }
			
		 }
		 System.out.println(answer);
	}

}
