public class 배열만들기1 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int n =10;
		int k=3;
		int size =n/k;
		int index = 0;
	int[] answer = new int[size];

		for(int i =1; i<=n; i++) {
			if(i%k == 0) {
				answer[index++] =i;
			}
		}
		System.out.println(answer);
		
		
		
