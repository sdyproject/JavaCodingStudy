package _250327;

import java.util.ArrayList;

public class 배열만들기1 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int n =15;
		int k=5;

		ArrayList<Integer> answer=  new ArrayList<>();
		for(int i =1; i<=n; i++) {
			if(i%k == 0) {
				answer.add(i);
			}
		}
		System.out.println(answer);
	}

}
