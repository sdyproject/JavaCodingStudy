		 * */
		String answer="";
		/*
		 * for(int i =0; i<code.length(); i++) { if(code.charAt(i)==1 && mode==0) {
		 * mode++; }else if(code.charAt(i)==1 && mode==1) { mode--; } }
		 */
		
		for(int idx =0; idx<code.length(); idx++) {
				
			char c = code.charAt(idx);
			
			if(c=='1') {
				mode = (mode==0) ? 1 : 0;
