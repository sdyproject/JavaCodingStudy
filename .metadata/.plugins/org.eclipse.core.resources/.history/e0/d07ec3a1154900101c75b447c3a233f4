package _250614;

public class _x만큼_간격이_있는_n개의_숫자 {

	public static void main(String[] args) {
		int x =-4;
		int n =2;
		int nativ = -Math.abs(x*n);
		System.out.println(nativ);
		
		long[] answer;
		if(x<0) {
			for(int i =x; i<nativ; i-=x) {
				System.out.println(i);
			}
			
		}else {
			for(int i =x; i<=x*n; i+=x) {
				System.out.println(i);
			}
		}
		
		
	}

}
