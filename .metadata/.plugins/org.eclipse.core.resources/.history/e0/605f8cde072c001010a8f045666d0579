package _250508;

public class 가운데_글자_가져오기 {

	public static void main(String[] args) {
		String s = "abcde";
//		String s = "qwer";
		
		String answer = "";
		
		
	System.out.println(String.valueOf(s.charAt(s.length()/2)));
		
		answer+= (s.length()%2==0) ? String.valueOf(s.charAt(s.length()/2)) + String.valueOf(s.charAt(s.length()/2)+1)  : String.valueOf( s.charAt(s.length()/2)+1) ;
		
		System.out.println(answer);
	}

}
