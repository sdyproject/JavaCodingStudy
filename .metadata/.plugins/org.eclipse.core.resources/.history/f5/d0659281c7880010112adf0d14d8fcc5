package 약수_배수와_소수_1;

import java.util.Scanner;

public class 소수_찾기 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N =sc.nextInt();
		int count = 0;
		for(int i = 1; i<=N; i++) {
			int num = sc.nextInt();
			
			if(num>1 && num/i==1) {
				count++;
			}
		}
		System.out.println(count);
	}

}
