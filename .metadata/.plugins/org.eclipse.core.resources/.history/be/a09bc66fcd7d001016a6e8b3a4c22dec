package _1차원_배열;

import java.util.Arrays;
import java.util.Scanner;

public class 공_바꾸기 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt(); int M = sc.nextInt();
		
		int[] n_arr = new int[N];
		int[] m_arr = new int[M];
		
		for(int i = 0; i<N; i++) {
			n_arr[i] = i;
		}
		
		for(int i = 0; i<M; i++) {
			m_arr[i] = i;
		}
		
       
		for(int k = 0; k<8; k++) {
			int i = sc.nextInt();
			int j = sc.nextInt();
			
			int temp =  n_arr[i];
			n_arr[i] = m_arr[j];
			m_arr[j] = temp;
			
		}
		
		System.out.println(Arrays.toString(n_arr));
	}

}
