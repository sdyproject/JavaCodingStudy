package 약수_배수와_소수_1;

import java.util.Scanner;

public class 소수 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int M = sc.nextInt();
		int N = sc.nextInt();
		
		int answer = 0;
		for (int i = M; i <= N; i++) {
			for (int j = 2; j <= Math.sqrt(i); j++) {
				if(i%j==0) {
					break;
				}else {
					answer+=i;
				}
			}
		}
		System.out.println(answer);
	}

}
