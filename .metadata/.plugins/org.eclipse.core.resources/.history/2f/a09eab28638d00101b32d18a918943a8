package 정렬;

import java.util.Arrays;
import java.util.Scanner;

public class 단어_정렬 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		String[] arr  = new String[N];
		
		for (int i = 0; i < N; i++) {
			arr[i] = sc.next();
		}

		System.out.println(Arrays.toString(arr));
	}

}
