package 약수_배수와_소수_1;

import java.util.Scanner;

public class 소수_찾기 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N =sc.nextInt();
		int count = 0;
		for(int i = 0; i<N; i++) {
			int num = sc.nextInt();
			
				for (int j = 2; j < num; j++) {
					if(num%j!=0) {
						count++;
						break;
					}
				}
			
		}
		System.out.println(count);
	}

}
