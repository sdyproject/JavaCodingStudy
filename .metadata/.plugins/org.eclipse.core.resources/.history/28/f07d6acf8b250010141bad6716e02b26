package _250430;

public class 수열과_구간_쿼리_1 {

	public static void main(String[] args) {
		int[] arr= {0,1,2,3,4}; 
		int[][] queries = {{0, 1},{1, 2},{2, 3}};
		
		for(int i =0; i<queries.length; i++) {
			int s = queries[i][0];
			int e = queries[i][1];
			if(s<=i && i<=e) {
				for(int  j = s; j<=e; j++) {
					System.out.println(arr[j]);
				}
			}
		}
	}

}
