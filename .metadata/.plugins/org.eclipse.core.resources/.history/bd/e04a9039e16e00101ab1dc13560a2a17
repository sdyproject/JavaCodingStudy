package _250801;

import java.util.Arrays;

public class 체육복 {

	public static void main(String[] args) {
		int n = 5; int[] lost = {2,4}; int[] reserve = {1,3,5};
//		int n = 5;  int[] lost = {2,4}; int[] reserve = {3};
//		int n = 3;  int[] lost = {3}; int[] reserve = {1}:
		int answer = n-reserve.length;
		
		for(int  i =0; i<lost.length; i++) {
			int front =lost[i]+1;
			int back =lost[i]-1;
			for(int j = 0; j<reserve.length; j++) {
				
				System.out.println(Arrays.toString(reserve));
				if(reserve[j]==0) {
					continue;
				}
				if(reserve[j]== front || reserve[j]== back) {
					reserve[j] = 0;
					answer++;
					break;
				}
			}
		}
		System.out.println(answer);
	}

}
