package _2차원_배열;

import java.util.Scanner;

public class 세로읽기 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		String[][] arr = new String[5][15];
		
		for(int i = 0; i < 5; i++) {
			String s = sc.next();
			for (int j = 0; j < s.length(); j++) {
				arr[i][j] = String.valueOf(s.charAt(j)); 

				
			}
		}
		for (int j = 0; j < 15; j++) {
			for (int i = 0; i < 5; i++) {
			 if(arr[i][j]!=null) {
				 System.out.print(arr[i][j]);
			 }
			}
		}
		

	}

}
