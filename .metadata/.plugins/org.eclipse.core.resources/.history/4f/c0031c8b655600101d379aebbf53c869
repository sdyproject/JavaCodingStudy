package _250701;

public class 콜라츠_추측 {
	public static void main(String[] args) {
		//주어진 수가 1이 될때까지 다음 작업을 반복하면 모든 수를 1로 만들 수 있다는 추측
		// 1. 입력된 수가 짝수라면 2로 나눕니다/
		// 2. 입력된 수가 홀수라면 3을 곱하고 1를 더합니다.
		// 결과로 나온 수에 같은 작업을 1이 될때가지 반복
		// 500 작업을 반복할때까지 1이 되지 않으면 -1 반환
		
		//제한 사항	
		//입력된 수, num은 1 이상 8,000,000 미만인 정수입니다.
		int answer = 0;
		
		int num = 6 ;
		int count =0;
//				int num = 16 ;
//				int num = 626331; 
				
				while(num!=1) {
					if(count>500) {
						answer= -1;
						break;
						
					}
					
					if(num%2==0) {
						num = num/2;
						count++;
					}else {
						num = num * 3 + 1;
						count++;
					}
					
				}
				System.out.println(count);
				

	}
}
