package _250513;

public class 약수의_개수와_덧셈 {

	public static void main(String[] args) {
		
		int start =13;
		int end =17;
		
//		int start =24;
//		int end =27;
		
		int num = 1;
		int hol = 0;
		int jjak =0;
		int answer =0;
		for(int i = start; i<=end; i++) {
			
			while(num<=i) {
				if(i%num==0) {
					jjak++;
				}else {
					hol++;
				}
				num++;
			}
			
			if(jjak%2==0) {
			answer+=i;
		}else {
			answer-=i;
		}
		
	}
		System.out.println(answer);
	}
}
