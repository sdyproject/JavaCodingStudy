package _문자열;

import java.util.Scanner;

public class 상수 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		int A = sc.nextInt();
		
		
		StringBuilder sb = new StringBuilder();
		sb.append(A);
		sb.reverse();
		sb.toString();
		System.out.println(sb);
	}

}
