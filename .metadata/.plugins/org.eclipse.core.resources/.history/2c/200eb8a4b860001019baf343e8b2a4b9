package _250714;

public class 하샤드_수 {

	public static void main(String[] args) {
		int x = 10;
//		int x = 12;
//		int x = 11;
//		int x = 13;
        boolean answer = true;
        int num = 0;
         String str =Integer.toString(x);
        for(int i =0; i<str.length(); i++) {
        	  num+=str.charAt(i);
        }
        System.out.println(num);
        if(x%num!=0) {
        	answer = false;
        }
        

        System.out.println(answer);
	}

}
