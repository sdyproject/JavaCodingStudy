package _250512;

public class 두_정수_사이_합 {

	public static void main(String[] args) {
		int  z = 3;
		int  y = 5;
		
//		int  z = 3;
//		int  y = 3;
		
//		int  z = 5;
//		int  y = 3;
		
		 long answer = 0;
		 
		 if(z>y) {
			 while(z>=y) {
				 answer +=z;
				 z--;
				 
			 }
			 
		 }else if(y>z) {
			 while(y>=z) {
				 answer +=y;
				 y++;
				 
			 }
		 }
		System.out.println(answer);
	}

}
