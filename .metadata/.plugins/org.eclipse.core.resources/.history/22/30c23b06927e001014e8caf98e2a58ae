package _1차원_배열;

import java.util.Scanner;

public class 평균 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		int N =  sc.nextInt();
		int max = 0;
		
		for(int i = 0; i<N; i++) {
			int a =sc.nextInt();
			if(max<a) {
				max = a;
			}
		}
		System.out.println(max);
	}

}
