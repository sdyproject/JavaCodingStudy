package algorithm.backjoon;

import java.util.Scanner;

public class 개수_세기 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		int[] arr = new int[N];
		
		for(int i = 0; i<N; i++) {
			arr[i] =  sc.nextInt();
		}
		
		int v =  sc.nextInt();
		
		int count = 0;
		
		for(int num : arr) {
			if(v==num) {
				count++;
			}
		}
		
		System.out.println(count);
		
		}

}
