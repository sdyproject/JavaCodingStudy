package _1차원_배열;

import java.util.Arrays;
import java.util.Scanner;

public class 나머지 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int[] arr = new int[10];
		for(int i = 0; i < 10; i++) {
			int A = sc.nextInt();
			arr[i] = A%42;
		}
		
		System.out.println(Arrays.toString(arr));
	}

}
