package _250720;

import java.util.ArrayList;

public class 문자열_나누기 {
	// 해결 못함
	public static void main(String[] args) {
		String s = "banana";
//		String s = "abracadabra";
//		String s = "aaabbaccccabba";
		  int answer = 0;
		
		int same  = 0;
		int different = 0;
		char first = s.charAt(0);
		for(int i = 0; i<s.length(); i++) {
			
			
			
			if(first==s.charAt(i)) {
				same++;
			}else {
				different++;
			}
			
			if(same==different) {
				answer++;
				same = 0;
				different = 0;
				first = s.charAt(i);
			}
			
			
		}
	System.out.println(answer);
		 
		
	}
		
}
