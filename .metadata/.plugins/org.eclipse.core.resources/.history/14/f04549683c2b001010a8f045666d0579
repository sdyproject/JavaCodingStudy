package _250417;

import java.util.Arrays;

public class 공백관련연습 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		String a = "    a a a ";
		System.out.println(a.trim());
		 String b=a.replace(" ","");
		System.out.println(b);
		
		String[] arr = a.split(" ");
		System.out.println(Arrays.toString(arr));
		
		
		String answer ="";
		for(String str :arr) {
			answer+=str;
		}
		System.out.println(answer);
	
		
		
	}

}
