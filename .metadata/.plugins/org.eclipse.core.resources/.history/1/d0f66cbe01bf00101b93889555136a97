package algorithm.backjoon.onearray;

import java.util.Scanner;

public class X보다_작은_수 {

	public static void main(String[] args) {
	
		        Scanner sc = new Scanner(System.in);
		        
		        int N = sc.nextInt();
		        int X = sc.nextInt();
		        int A[] = new int[N];
		        for(int i =0; i<N; i++) {
					A[i] = sc.nextInt();
				}
		        
		        for(int a  : A) {
		        	if(X>a) {
		        		System.out.print(a + " ");
		        	}
		        }
		        
	}

}
