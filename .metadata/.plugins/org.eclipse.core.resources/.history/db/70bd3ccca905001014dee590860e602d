package _250321;

import java.util.ArrayList;
import java.util.List;

public class 수열과_구간_쿼리_2 {

	public static void main(String[] args) {
		// TODO s, e , k
		// s<= i <= e k보다 크면서 arr[i]찾는다
		// 결과 : [3, 4, -1]
		// 
		int[] arr = {0, 1, 2, 4, 3};
		int[][] queries = {{0,4,2},{0,3,2},{0,0,2}};
		List<Integer> answer = new ArrayList();
		int min = 0;
		System.out.print(queries[0][0]);
		System.out.print(queries[0][1]);
		System.out.println(queries[0][2]);
		System.out.print(queries[1][0]);
		System.out.print(queries[1][1]);
		System.out.println(queries[1][2]);
		
		
		
	
		for(int i =0; i<queries.length; i++) {
			   for(int j=0; j<arr.length; j++) {
				   if(queries[i][0]<=arr[j] && arr[j]<=queries[i][1] && arr[j]>queries[i][2] && arr[j]<min) {
					   answer.add(min);
				   }
			   }
		}
		System.out.println(answer);
	}

}
