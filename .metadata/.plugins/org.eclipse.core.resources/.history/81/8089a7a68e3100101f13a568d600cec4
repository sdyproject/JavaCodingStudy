package _250515;

public class 콜라츠_추측 {

	public static void main(String[] args) {
//		int num = 6;
       
        int num = 16;
        
//        int num = 626331;
       
        int answer = 0;
        
		while(num>1) {
			if(num%2==0) {
				num=num/2;
				answer++;
				System.out.println(num);

			}else {
				num=num*3+1;
				answer++;
				System.out.println(num);

			}

		}
		
		System.out.println(answer);
	}

}
