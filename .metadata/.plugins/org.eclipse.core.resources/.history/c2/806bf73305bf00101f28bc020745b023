package _1차원_배열.copy;

import java.util.Scanner;

public class 평균 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		int N =  sc.nextInt();
		int M = 0;
		double total = 0.0;
		for(int i = 0; i<N; i++) {
			int a =sc.nextInt();
			
			total+= a;
			
			if(M<a) {
				M = a;
			}
		}
		
		System.out.println(((total/M)*100)/N);
	}

}
