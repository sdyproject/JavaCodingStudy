package _250513;

public class 약수의_개수와_덧셈 {

	public static void main(String[] args) {
		
		int start =13;
		int end =17;
		
//		int start =24;
//		int end =27;
		
		int count =0;
		int answer =0;
		for(int i = start; i<=end; i++) {
			
			for(int j =1; j<=i; j++) {
				
				if(i%j==0) {
					count++;
					
				}
				
				
			}
			if(count%2==0) {
				System.out.println(answer);
				answer+=i;
			}else {
				answer-=i;
			}
			

//			if(jjak%2==0) {
//			answer+=i;
//		}else if(hol%2!=0){
//			answer-=i;
//		}
		
	}
		System.out.println(answer);
	}
}
