package _250319;

public class 이어붙인_수 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int[] num_list = {3, 4, 5, 2, 1};
		String sum1="";
		String sum2="";
		for(int  num:num_list) {
			if(num/2==0) {
				sum2+=num;
			}else {
				sum1+=num;
			}
			
			
		}
		System.out.println(sum2);
		System.out.println(sum1);
	}

}
