package _250819;

public class 푸드_파이트_대회 {

	public static void main(String[] args) {
		int [] food = {1,3,4,6};
		
//		int [] food = {};

		String answer = "";
		
		
		for(int i=1; i<food.length; i++) {
			if(food[i]%2==0) {
				answer+=String.valueOf(i);
			}else {
				answer +=  String.valueOf(i) ;
			}
		}
		System.out.println(answer);
	}

}
