package _250320;

import java.util.Iterator;

public class 수열과_구간_쿼리_3 {

	public static void main(String[] args) {
		// 프로그래머스 문제 
		
		int[] arr = {0, 1, 2, 3, 4};
		int[][] queries = {{0,3},{1,2},{1,4}};
		
		int quer1 =0;		
		
		
		for(int i=0; i<queries.length; i++) {
			for(int j=0; j<arr.length; j++) {
				
					quer1= arr[j];
					arr[j] = queries[i][i+1];
					queries[i][j+1] = quer1;
			}
		}
		System.out.println(arr);
	}

}
