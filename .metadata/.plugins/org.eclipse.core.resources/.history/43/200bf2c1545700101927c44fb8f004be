package _250702;

public class 대충_만든_자판 {

	public static void main(String[] args) {
		String[] keymap = {"ABACD", "BCEFD"}; String[] targets= {"ABCD","AABB"};
//		String[] keymap = {}; String[] targets= {};
//		String[] keymap = {}; String[] targets= {};
		
//		String a = "ABCD"; 
		int first = 0;
		int second = 0;
		int count = 0;
		for(int i =0; i<targets.length; i++) {
			for(int j =0; j<targets[i].length(); j++) {
				for(int k =0; k<keymap.length; k++) {
//					System.out.println(targets[k].lastIndexOf(keymap[i].charAt(j))+1);
					
					if(j==0) {
						 first = targets[k].lastIndexOf(keymap[i].charAt(j));
					}else {
						second = targets[k].lastIndexOf(keymap[i].charAt(j));
					}
					 
					if(first > second) {
						count=second+1;
						
					}else if(second > first){
						count = first+1;
					}else if(second == first){
						count=second+1;
					}else if(first==-1 && second==-1){
						count= -1;
					}
					System.out.println(first);
				}
			}
		}
		
		System.out.println(count);
	}

}
