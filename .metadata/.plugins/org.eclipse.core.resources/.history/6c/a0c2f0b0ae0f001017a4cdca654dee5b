package _250402;

public class 문자열_바뀌서_찾기 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
	String	myString = "ABBAA";
	String	pat = "AABB";
	
        int answer = 0;
	char[] arr = myString.toCharArray();
	
	for(int i = 0; i<arr.length; i++) {
		if(arr[i] =='A') {
			arr[i] ='B';
		}else {
			arr[i] ='A';
		}
	}
		if( arr.equals(pat)) {
			answer++;
		}
	System.out.println(answer);
	}

}
