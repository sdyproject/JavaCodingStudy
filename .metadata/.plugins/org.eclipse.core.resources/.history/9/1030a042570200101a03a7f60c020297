package _250316;

import java.util.Scanner;

public class 홀짝에_따라_다른값_반환하기 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc = new Scanner(System.in);
        int n =sc.nextInt();
        int answer=0;
        if(n%2==0) {
        	while(n<=n) {
        		if(n % 2 == 0) {
    			 answer = n;
    			}
    			
    		}
        	
        	System.out.println(answer);	
        }else{
        	while(n<=n) {
        		if(n % 2 != 0) {
    			 answer = n;
    			}
    		
    		}
        	System.out.println(answer);	
        }
        
	}

}
