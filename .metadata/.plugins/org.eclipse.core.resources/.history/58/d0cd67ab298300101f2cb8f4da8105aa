package _2차원_배열;

import java.util.Scanner;

public class 최댓값 {

	public static void main(String[] args) {

		
	 Scanner sc =  new Scanner(System.in);
	 
	 int[][] arr =  new int[9][9];

	 for (int i = 0; i < arr.length; i++) {
		int line = sc.nextInt();
		
		for (int j = 0; j < arr.length; j++) {
			arr[i][j] = line;
			}
	 }
	
	 
	 for (int i = 0; i < arr.length; i++) {
		    for (int j = 0; j < arr.length; j++) {
		        System.out.print(arr[i][j] + " ");
		    }
		}
	 
	}

}
