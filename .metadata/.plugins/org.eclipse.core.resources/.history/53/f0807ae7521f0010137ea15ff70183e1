		String my_string = "hi12392";
		
		String str= my_string.replaceAll("[^0-9]", "");
		
		int num =Integer.parseInt(str);
		 
		 ArrayList<Integer> answer = new ArrayList<>();
		 
		 for(int i =0; i<str.length(); i++) {
			 answer.add(num);
		 }
		System.out.println(answer);
	}
	}
