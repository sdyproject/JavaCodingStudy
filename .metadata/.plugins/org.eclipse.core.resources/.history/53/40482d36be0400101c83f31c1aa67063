package _250319;

public class 이어붙인_수 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int[] num_list = {3, 4, 5, 2, 1};
		String sum1="";
		String sum2="";
		for(int i=0; i<num_list.length; i++) {
			if(num_list[i]/2==0) {
				sum2+=num_list[i];
			}else {
				sum1+=num_list[i];
			}
			
		}
		int answer = Integer.parseInt(sum1+sum2);
		System.out.println(answer);
	}

}
