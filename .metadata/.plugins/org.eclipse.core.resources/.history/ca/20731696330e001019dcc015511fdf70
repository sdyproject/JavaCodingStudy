package _250331;

public class _1로_만들기 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int[] num_list = {12, 4, 15, 1, 14};
		int answer = 0;
		
		for(int num : num_list) {
			if(num%2 ==0) {
				num/=2;
				if(num ==1) {
					answer++;
				}
				
			}else {
				(num-1)/2;
				if(num ==1) {
					answer++;
				}
			}
		}
		System.out.println(answer);
	}

}
