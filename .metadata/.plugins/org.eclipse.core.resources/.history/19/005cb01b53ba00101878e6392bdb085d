package 재귀;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.Stack;

public class 하노이_탑_이동_순서 {

	public static StringBuilder sb = new StringBuilder();
	public static void main(String[] args) throws IOException{
		/*3개의 장대 존재
		 * 첫번째 장대 반경이 서로 다른 n개의 원판이 쌓여있다. 각 원판은 반경이 큰 순서대로 쌓여있다. 규칙에 따라 첫번째 장대에서 세번째 장대로 이동시킬려고한다.
		 * 조건 1
		 * 한번에 한개의 원판만 다른탑으로 옮길수 있다.
		 * 조건 2
		 * 쌓아 놓은 원판은 항상 위의 것이 아래 것보다 작아야한다.*/
		

		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		
		int n = Integer.parseInt(br.readLine());
		
		sb.append((int) Math.pow(2, n) +1+"/n");
		hanoi(n, 1, 2, 3);
		System.out.println(sb);
	}
	
	public static void hanoi(int n, int start, int temp, int end) {
		if(n == 1) {
			sb.append(start+" "+end+"/n");
			return;
		}
		
		hanoi(n-1, start, end, temp);
		
		sb.append(start+" "+ end+"/n");
		
		hanoi(n-1, temp, start, end);
		
		
	}

}
