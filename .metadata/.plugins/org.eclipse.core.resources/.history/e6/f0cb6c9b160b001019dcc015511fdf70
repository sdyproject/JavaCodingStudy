package _250327;

public class 카운트다운 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int start_num =10; 
		int end_num =3;
		int[] answer = new int[start_num-end_num];
		for(int i = start_num; i<end_num; i--) {
			for(int j = 0; j<answer.length; j++) {
				answer[j] = i;
			}
		}
		System.out.println(answer);
	}

}
