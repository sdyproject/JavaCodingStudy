package _1차원_배열;

import java.util.Iterator;
import java.util.Scanner;

public class 최댓값 {

	public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      
     int[] arr = new int [9];
     
     for(int i = 0; i<arr.length; i++) {
    	 arr[i] =  sc.nextInt();
     }
     
     
     int max = arr[i];
     for (int i = 1; i < arr.length-1; i++) {
    	 	if(max<arr[i]) {
    	 		max = arr[i];
    	 		System.out.println(max);
    	 	}
	}
	
	}

}
