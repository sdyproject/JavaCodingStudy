package _250818;

import java.util.Arrays;

public class 소수_찾기 {

	public static void main(String[] args) {
		int n = 10;
//		int n = 5;
		int answer = 0;
		
		boolean[] arr = new boolean[n+1];
		
		Arrays.fill(arr, 2,arr.length-1, true);;
		System.out.println(Arrays.toString(arr));

		
		for (int i = 2; i * i <= n; i++) {
		    if (arr[i]) {
		        for (int j = i * i; j <= n; j += i) {
		            arr[j] = false;
		        }
		    }
		}
		System.out.println(Arrays.toString(arr));

	}

}
