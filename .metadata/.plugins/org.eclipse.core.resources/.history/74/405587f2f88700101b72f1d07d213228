package 약수_배수와_소수_1;

import java.util.Scanner;

public class 약수_구하기 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int N = sc.nextInt();
		int K = sc.nextInt();
		
		
		for (int i = 0; i < N; i++) {
			if(N%i==0 && i==K) {
				System.out.println(i);
				break;
				
			}else {
				System.out.println("0");
			}
			
		}
		
	}

}
