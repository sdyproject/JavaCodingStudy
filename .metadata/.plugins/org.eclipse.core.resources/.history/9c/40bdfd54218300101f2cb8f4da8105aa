package _2차원_배열;

import java.util.Scanner;

public class 세로읽기 {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		String[][] arr = new String[5][5];
		for (int i = 0; i < 5; i++) {
			for (int j = 0; j < 5; j++) {
				String s =  sc.next();
				arr[i][j] = String.valueOf(s.charAt(j)); 
				System.out.println(arr[i][j]);

			}
		}
		
