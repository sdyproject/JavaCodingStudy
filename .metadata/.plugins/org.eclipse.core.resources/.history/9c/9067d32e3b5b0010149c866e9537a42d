package _250707;

import java.util.Arrays;

public class 옹알이_2 {

	public static void main(String[] args) {
		 int answer = 0;
//		String[] babbling = {"aya", "yee", "u", "maa"};
		String[] babbling = {"ayaye", "uuu", "yeye", "yemawoo", "ayaayaa"};
		String [] baby_word = {"aya", "ye", "woo", "ma"};
		
		//조카 단어
		// "aya", "ye", "woo", "ma"
		
		
		for(int i =0; i<baby_word.length; i++) {
			for(int j =0; j<babbling.length; j++) {
				if(babbling[j].contains(baby_word[j])) {
					String str = babbling[j].substring(baby_word[j].length());
					
					if(str.equals(baby_word[j])) {
						babbling[i] = " ";
					}else {
						babbling[i] = str;
					}
				}
			}
		}
			
		
		System.out.println(Arrays.toString(babbling));
			
	}

}
