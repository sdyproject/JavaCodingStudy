package _250428;

public class 특별한_이차원_배열_2 {

	public static void main(String[] args) {
		int[][] arr = {{5,192,33},{192,72,95},{33,95,99}};
		
		int answer =0;
		
		for(int  i =0; i<arr.length; i++) {
			for(int j = 1; j<arr.length; j++) {
				if(arr[i][j]==arr[j][i]) {
					
					answer=1;
				}else {
					answer=0;
				}
			}
		}
		
		System.out.println(answer);
	}

}
