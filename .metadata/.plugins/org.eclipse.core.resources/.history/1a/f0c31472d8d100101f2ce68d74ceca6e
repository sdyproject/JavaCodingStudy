		String cipher  = st.nextToken();
		int code  = Integer.parseInt(st.nextToken());
		
		String answer = " ";
		for (int i = 4; i < cipher.length(); i+=4) {
			 answer+= cipher.charAt(i);
		}
		System.out.println(answer);
	}

}
