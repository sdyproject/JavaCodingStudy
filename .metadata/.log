		for(int i = 0; i<lost.length; i++) {
			int front = lost[i] - 1;
			int back = lost[i] + 1;
				for(int j = 0+i; j<reserve.length; j++) {
						if(front== reserve[j] || back == reserve[j]) {
							reserve[j] = 0;
							
							break;
							
						}else {
							count-1
						}
			}
		}
		
		System.out.println(count);

	}

}

